{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vocalkeep",
  "mainBinaryName": "vocalkeep-desktop",
  "version": "0.1.0",
  "identifier": "io.github.lobojoel2003.vocalkeep",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Vocalkeep",
        "width": 1180,
        "height": 800,
        "minWidth": 420,
        "minHeight": 520,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Vocalkeep contributors",
    "copyright": "© Vocalkeep contributors. GPL-3.0-or-later.",
    "category": "Utility",
    "shortDescription": "Bank your own voice",
    "longDescription": "Vocalkeep is a calm recording studio for voice banking. Record short sessions of sentences now, and build a text-to-speech voice that sounds like you for your communication app later. Everything stays on your computer.",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "homepage": "https://github.com/lobojoel2003/Vocalkeep",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libasound2t64 | libasound2"],
        "section": "sound"
      },
      "rpm": {
        "depends": ["alsa-lib"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
